# ======================================================================
# GelaCar v2 — configuração da NOVA operação.
# Copie para .env e preencha. Nunca comite o .env.
# Nada aqui é herdado da operação original: pixel, chaves e domínio são só desta estrutura.
# ======================================================================

PORT=3000

# --- Domínio -----------------------------------------------------------
# URL pública do NOVO domínio, sem barra final. Usada nos links canônicos e
# para montar o webhook da Adex. (Defina antes de ir ao ar.)
SITE_URL=https://SEU-NOVO-DOMINIO.com.br

# Endereço público desta API (vira o webhook da Adex: PUBLIC_URL + /api/webhooks/adex).
PUBLIC_URL=

# Opcional: restringe quem pode chamar a API a um site (ex.: https://seusite.com.br). Vazio = qualquer site.
CORS_ORIGIN=

# --- Armazenamento -----------------------------------------------------
# Pasta do banco SQLite (pedidos, leads, eventos). Em produção aponte para um
# volume persistente (ex.: Railway Volume montado em /data).
DATA_DIR=./data

# --- Painel de pedidos -------------------------------------------------
# Token (texto longo e aleatório) para abrir /admin/pedidos?token=... e /api/admin/orders.
ADMIN_TOKEN=

# --- Adex (Pix) --------------------------------------------------------
# Chaves da Adex destinadas a ESTA estrutura (painel Adex > Chaves API).
ADEX_PUBLIC_KEY=
ADEX_SECRET_KEY=
# Webhook que a Adex chama quando o Pix muda de status. Se vazio, usa SITE_URL + /api/webhooks/adex
ADEX_WEBHOOK_URL=
# A documentação da Adex é ambígua sobre o campo amount. "reais" (padrão) ou "cents".
# Confirme com uma cobrança de teste: o servidor compara o valor embutido no Pix
# com o esperado e recusa a cobrança se divergir (ADEX_VERIFY_EMV).
# Segredo do webhook, se a Adex mostrar um separado (vazio = usa a secret key)
ADEX_WEBHOOK_SECRET=
ADEX_AMOUNT_UNIT=reais
ADEX_VERIFY_EMV=true

# --- Meta (Pixel + API de Conversões) -----------------------------------
# Pixel NOVO, do novo domínio.
META_PIXEL_ID=
# Token de acesso da API de Conversões gerado para esse pixel (Gerenciador de Eventos > Configurações).
META_CAPI_TOKEN=
# Opcional: código do "Testar eventos" para validar sem afetar a otimização.
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0

# --- UTMify (opcional) ---------------------------------------------------
# ID do pixel da UTMify DESTA operação (script no navegador). Vazio = script não é carregado.
UTMIFY_PIXEL_ID=
# Token da API de pedidos da UTMify (envio server-side waiting_payment/paid). Vazio = desligado.
UTMIFY_API_TOKEN=

# --- Checkout ------------------------------------------------------------
# O fluxo implementado é Pix (Adex). Cartão fica oculto enquanto não houver integração de cartão.
CARD_ENABLED=false

# --- Somente desenvolvimento / testes (NÃO use em produção) -------------
# Simula a Adex: gera um Pix fictício e libera /api/dev/simulate-payment. Nada é cobrado.
ADEX_MOCK=false
# Registra as chamadas do Pixel em window.__fbqLog em vez de carregar o fbevents.js.
DEBUG_FBQ_STUB=false
